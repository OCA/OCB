#. module: populate
#. odoo-python
#: code:addons/populate/models/session.py:0
msgid "%(count)s parallel job(s) failed"
msgstr "%(count)s ວຽກງານຂະໜານລົ້ມເຫຼວ"

#. module: populate
#. odoo-python
#: code:addons/populate/models/blueprint.py:0
msgid "%(operation)s blocks cannot define 'arg'."
msgstr "ບລັອກ %(operation)s ບໍ່ສາມາດກຳນົດ 'arg' ໄດ້."

#. module: populate
#. odoo-python
#: code:addons/populate/generators/relation.py:0
msgid "'%(comodel_name)s' isn't a valid model name."
msgstr "'%(comodel_name)s' ບໍ່ແມ່ນຊື່ໂມເດວທີ່ຖືກຕ້ອງ."

#. module: populate
#. odoo-python
#: code:addons/populate/generators/relation.py:0
msgid "'%(groupby)s' isn't a valid field for model '%(comodel_name)s'."
msgstr "'%(groupby)s' ບໍ່ແມ່ນຊ່ອງຂໍ້ມູນທີ່ຖືກຕ້ອງສຳລັບໂມເດວ '%(comodel_name)s'."

#. module: populate
#. odoo-python
#: code:addons/populate/models/blueprint.py:0
msgid "'%(import_ref)s' refers to '%(model)s', not a populate blueprint."
msgstr "'%(import_ref)s' ອ້າງອີງເຖິງ '%(model)s', ບໍ່ແມ່ນແບບແຜນ populate."

#. module: populate
#. odoo-python
#: code:addons/populate/generators/relation.py:0
msgid "'comodel_name' needs to be provided for generated values."
msgstr "ຈຳເປັນຕ້ອງລະບຸ 'comodel_name' ສຳລັບຄ່າທີ່ສ້າງຂຶ້ນ."

#. module: populate
#. odoo-python
#: code:addons/populate/models/blueprint.py:0
msgid "<import> may only contain inheritance specifications."
msgstr "<import> ສາມາດບັນຈຸໄດ້ສະເພາະຂໍ້ກຳນົດການສືບທອດເທົ່ານັ້ນ."

#. module: populate
#. odoo-python
#: code:addons/populate/models/blueprint.py:0
msgid "<import> requires a fully qualified XML ID in 'ref'."
msgstr "<import> ຕ້ອງການ XML ID ທີ່ຄົບຖ້ວນສົມບູນໃນ 'ref'."

#. module: populate
#. odoo-python
#: code:addons/populate/models/session.py:0
msgid "A created session should have jobs associated from a blueprint."
msgstr "ເຊດຊັນທີ່ສ້າງຂຶ້ນຄວນມີວຽກງານທີ່ກ່ຽວຂ້ອງມາຈາກແບບແຜນ."

#. module: populate
#: model:ir.model.constraint,message:populate.constraint_populate_job_unique_ref_per_session
msgid ""
"A job with this reference already exists in this session. References must be "
"unique for create operations within a session."
msgstr ""
"ມີວຽກງານທີ່ມີການອ້າງອີງນີ້ຢູ່ແລ້ວໃນເຊດຊັນນີ້. ການອ້າງອີງຕ້ອງບໍ່ຊ້ຳກັນ ສຳລັບການດຳເນີນການສ້າງພາຍໃນເຊດຊັ"
"ນ."

#. module: populate
#: model:ir.model.constraint,message:populate.constraint_populate_job_record_count_invariant
msgid ""
"A job's record_count needs to be a non-zero positive integer. Only write and "
"function jobs are allowed to have no record_count, whose cardinality is "
"unknown at creation time."
msgstr ""
"record_count ຂອງວຽກງານຕ້ອງເປັນຈຳນວນຖ້ວນບວກທີ່ບໍ່ແມ່ນສູນ. ອະນຸຍາດໃຫ້ສະເພາະວຽກງານ write ແລ"
"ະ function ເທົ່ານັ້ນທີ່ບໍ່ມີ record_count, ເຊິ່ງຍັງບໍ່ຮູ້ຈຳນວນທີ່ແນ່ນອນໃນຕອນສ້າງ."

#. module: populate
#. odoo-python
#: code:addons/populate/models/session.py:0
msgid "Adapt the generator parameter to generate values within the constraint"
msgstr "ປັບປ່ຽນພາລາມິເຕີຂອງຕົວສ້າງ ເພື່ອສ້າງຄ່າໃຫ້ຢູ່ໃນເງື່ອນໄຂບັງຄັບ"

#. module: populate
#. odoo-python
#: code:addons/populate/models/blueprint.py:0
msgid "An import namespace cannot be empty."
msgstr "import namespace ບໍ່ສາມາດຫວ່າງເປົ່າໄດ້."

#. module: populate
#: model:ir.model.fields,field_description:populate.field_populate_job__batched
msgid "Batched"
msgstr "ເຮັດເປັນຊຸດ"

#. module: populate
#: model:ir.model.fields,field_description:populate.field_populate_job__blueprint_id
#: model:ir.model.fields,field_description:populate.field_populate_model_data__blueprint_id
#: model:ir.model.fields,field_description:populate.field_populate_session__blueprint_id
msgid "Blueprint"
msgstr "ແບບແຜນ"

#. module: populate
#. odoo-python
#: code:addons/populate/models/blueprint.py:0
msgid ""
"Blueprint '%(blueprint)s': %(reason)s\n"
"Definition that failed:\n"
"%(definition)s"
msgstr ""
"ແບບແຜນ '%(blueprint)s': %(reason)s\n"
"ຄຳນິຍາມທີ່ລົ້ມເຫຼວ:\n"
"%(definition)s"

#. module: populate
#: model:ir.model.fields,field_description:populate.field_populate_blueprint__name
msgid "Blueprint Name"
msgstr "ຊື່ແບບແຜນ"

#. module: populate
#: model:ir.model.fields,help:populate.field_populate_blueprint__inherit_id
msgid ""
"Blueprint to inherit from. Use XPath expressions in definition_xml to modify "
"the parent."
msgstr ""
"ແບບແຜນທີ່ຈະສືບທອດມາ. ໃຊ້ຄຳສັ່ງ XPath ໃນ definition_xml ເພື່ອດັດແກ້ຕົວແມ່."

#. module: populate
#: model:ir.model.fields,help:populate.field_populate_job__parallel
msgid "Can the job be executed in parallel?"
msgstr "ວຽກງານນີ້ສາມາດດຳເນີນການແບບຂະໜານພ້ອມກັນໄດ້ບໍ່?"

#. module: populate
#. odoo-python
#: code:addons/populate/models/session.py:0
msgid "Cannot grab the advisory lock on the session %s."
msgstr "ບໍ່ສາມາດດຶງ advisory lock ໃນເຊດຊັນ %s ໄດ້."

#. module: populate
#. odoo-python
#: code:addons/populate/generators/generator.py:0
msgid ""
"Cannot have both a distribution and weighted values. Please provide either "
"'distribution' or 'values' with weights, but not both."
msgstr ""
"ບໍ່ສາມາດມີທັງການແຈກຢາຍ ແລະ ຄ່ານ້ຳໜັກພ້ອມກັນໄດ້. ກະລຸນາລະບຸ 'distribution' ຫຼື 'values' ພ້ອມກັ"
"ບນ້ຳໜັກຢ່າງໃດຢ່າງໜຶ່ງ, ແຕ່ບໍ່ແມ່ນທັງສອງຢ່າງ."

#. module: populate
#. odoo-python
#: code:addons/populate/generators/generator.py:0
msgid "Cannot have repeated entries in `values`."
msgstr "ບໍ່ສາມາດມີລາຍການທີ່ຊ້ຳກັນໃນ `values` ໄດ້."

#. module: populate
#. odoo-python
#: code:addons/populate/generators/generator.py:0
msgid ""
"Cannot infer valid targets for a generated value. The 'valid_targets' "
"parameter must be explicitly provided."
msgstr ""
"ບໍ່ສາມາດຄາດເດົາເປົ້າໝາຍທີ່ຖືກຕ້ອງສຳລັບຄ່າທີ່ສ້າງຂຶ້ນໄດ້. ຕ້ອງລະບຸພາລາມິເຕີ 'valid_targets' ຢ່າງຊັດເຈ"
"ນ."

#. module: populate
#. odoo-python
#: code:addons/populate/models/session.py:0
msgid "Cannot run a parallel session during tests."
msgstr "ບໍ່ສາມາດດຳເນີນການເຊດຊັນແບບຂະໜານໃນລະຫວ່າງການທົດສອບໄດ້."

#. module: populate
#. odoo-python
#: code:addons/populate/generators/generator.py:0
msgid ""
"Cannot specify a null fraction for a required field. Field '%(field_name)s' "
"is required and cannot have null values."
msgstr ""
"ບໍ່ສາມາດກຳນົດອັດຕາສ່ວນຄ່າວ່າງ (null fraction) ສຳລັບຊ່ອງຂໍ້ມູນທີ່ຈຳເປັນໄດ້. ຊ່ອງຂໍ້ມູນ '%"
"(field_name)s' ແມ່ນຈຳເປັນ ແລະ ບໍ່ສາມາດມີຄ່າ null ໄດ້."

#. module: populate
#. odoo-python
#: code:addons/populate/generators/generator.py:0
msgid ""
"Cannot specify a null fraction when using weighted values. The 'null_ratio' "
"parameter is incompatible with custom weights."
msgstr ""
"ບໍ່ສາມາດກຳນົດອັດຕາສ່ວນຄ່າວ່າງ (null fraction) ເມື່ອໃຊ້ນ້ຳໜັກຄ່າໄດ້. ພາລາມິເຕີ 'null_ratio' ບໍ່ເ"
"ຂົ້າກັນກັບການກຳນົດນ້ຳໜັກເອງ."

#. module: populate
#: model:ir.model.fields,field_description:populate.field_populate_job__child_ids
msgid "Child"
msgstr "ລາຍການລູກ"

#. module: populate
#. odoo-python
#: code:addons/populate/models/session.py:0
msgid ""
"Consider using a generator (or combination of) that produces more varied "
"values"
msgstr "ພິຈາລະນາໃຊ້ຕົວສ້າງ (ຫຼື ລວມກັນ) ທີ່ສ້າງຄ່າທີ່ມີຄວາມຫຼາກຫຼາຍກວ່າ"

#. module: populate
#: model:ir.model.fields,field_description:populate.field_populate_job__context
msgid "Context"
msgstr "ບໍລິບົດ"

#. module: populate
#. odoo-python
#: code:addons/populate/generators/generator.py:0
msgid ""
"Could not generate a value because required dependencies are missing: %"
"(missing_deps)s. Expected dependencies: %(expected_deps)s."
msgstr ""
"ບໍ່ສາມາດສ້າງຄ່າໄດ້ເນື່ອງຈາກຂາດສິ່ງທີ່ຈຳເປັນຕ້ອງໃຊ້: %(missing_deps)s. ສິ່ງທີ່ຈຳເປັນທີ່ຄາດໄວ້: %"
"(expected_deps)s."

#. module: populate
#. odoo-python
#: code:addons/populate/generators/generator.py:0
msgid "Couldn't find a unique value for target %(target)s."
msgstr "ບໍ່ພົບຄ່າທີ່ບໍ່ຊ້ຳກັນສຳລັບເປົ້າໝາຍ %(target)s."

#. module: populate
#: model:ir.model.fields.selection,name:populate.selection__populate_job__operation__create
msgid "Create"
msgstr "ສ້າງ"

#. module: populate
#. odoo-python
#: code:addons/populate/models/blueprint.py:0
msgid "Create blocks cannot define 'batched'."
msgstr "ບລັອກ Create ບໍ່ສາມາດກຳນົດ 'batched' ໄດ້."

#. module: populate
#. odoo-python
#: code:addons/populate/models/blueprint.py:0
msgid "Create blocks use 'id', not 'ref'."
msgstr "ບລັອກ Create ໃຊ້ 'id', ບໍ່ແມ່ນ 'ref'."

#. module: populate
#: model:ir.model.constraint,message:populate.constraint_populate_job_create_job_without_domain
msgid "Create jobs cannot define a domain."
msgstr "ວຽກງານ Create ບໍ່ສາມາດກຳນົດ domain ໄດ້."

#. module: populate
#. odoo-python
#: code:addons/populate/models/blueprint.py:0
msgid "Create reference '%(ref)s' is declared more than once."
msgstr "ການອ້າງອີງການສ້າງ '%(ref)s' ຖືກປະກາດຫຼາຍກວ່າໜຶ່ງຄັ້ງ."

#. module: populate
#: model:ir.model.fields,field_description:populate.field_populate_blueprint__create_uid
#: model:ir.model.fields,field_description:populate.field_populate_job__create_uid
#: model:ir.model.fields,field_description:populate.field_populate_session__create_uid
msgid "Created by"
msgstr "ສ້າງໂດຍ"

#. module: populate
#: model:ir.model.fields,field_description:populate.field_populate_blueprint__create_date
#: model:ir.model.fields,field_description:populate.field_populate_job__create_date
#: model:ir.model.fields,field_description:populate.field_populate_session__create_date
msgid "Created on"
msgstr "ສ້າງເມື່ອ"

#. module: populate
#: model:ir.model,name:populate.model_populate_blueprint
msgid "Data Population Blueprint"
msgstr "ແບບແຜນການສ້າງຂໍ້ມູນ (Data Population Blueprint)"

#. module: populate
#: model:ir.model,name:populate.model_populate_job
msgid "Data Population Job"
msgstr "ວຽກງານການສ້າງຂໍ້ມູນ (Data Population Job)"

#. module: populate
#: model:ir.model,name:populate.model_populate_session
msgid "Data Population Session"
msgstr "ເຊດຊັນການສ້າງຂໍ້ມູນ (Data Population Session)"

#. module: populate
#: model:ir.model.fields,field_description:populate.field_populate_blueprint__display_name
#: model:ir.model.fields,field_description:populate.field_populate_job__display_name
#: model:ir.model.fields,field_description:populate.field_populate_model_data__display_name
#: model:ir.model.fields,field_description:populate.field_populate_session__display_name
msgid "Display Name"
msgstr "ຊື່ທີ່ສະແດງ"

#. module: populate
#: model:ir.model.fields,field_description:populate.field_populate_job__domain
msgid "Domain"
msgstr "ໂດເມນ"

#. module: populate
#: model:ir.model.fields,help:populate.field_populate_job__domain
msgid "Domain selecting target records for jobs that update existing records."
msgstr ""
"ໂດເມນສຳລັບເລືອກລາຍການບັນທຶກເປົ້າໝາຍ ສຳລັບວຽກງານທີ່ອັບເດດລາຍການບັນທຶກທີ່ມີຢູ່."

#. module: populate
#: model:ir.model.constraint,message:populate.constraint_populate_blueprint_has_definition
msgid "Either XML or JSON definition must be provided"
msgstr "ຕ້ອງລະບຸຄຳນິຍາມເປັນ XML ຫຼື JSON ຢ່າງໃດຢ່າງໜຶ່ງ"

#. module: populate
#. odoo-python
#: code:addons/populate/models/blueprint.py:0
msgid ""
"Error applying blueprint inheritance from '%(parent)s' to '%(child)s': %"
"(error)s"
msgstr ""
"ເກີດຂໍ້ຜິດພາດໃນການສືບທອດແບບແຜນຈາກ '%(parent)s' ໄປຫາ '%(child)s': %(error)s"

#. module: populate
#. odoo-python
#: code:addons/populate/utils/orm.py:0
msgid ""
"Field path '%(path)s' from '%(ref)s' resulted in model '%(got)s', but "
"expected '%(expected)s'"
msgstr ""
"ເສັ້ນທາງຊ່ອງຂໍ້ມູນ '%(path)s' ຈາກ '%(ref)s' ໄດ້ຜົນເປັນໂມເດວ '%(got)s', ແຕ່ຄາດຫວັງແມ່ນ '%"
"(expected)s'"

#. module: populate
#: model:ir.model.fields,help:populate.field_populate_job__batched
msgid ""
"For write/function jobs: generate one value set and perform one call per "
"executable job."
msgstr ""
"ສຳລັບວຽກງານ write/function: ສ້າງຊຸດຄ່າໜຶ່ງຊຸດ ແລະ ເອີ້ນໃຊ້ໜຶ່ງຄັ້ງຕໍ່ວຽກງານທີ່ປະມວນຜົນໄດ້."

#. module: populate
#: model:ir.model.fields.selection,name:populate.selection__populate_job__operation__function
msgid "Function"
msgstr "ຟັງຊັນ"

#. module: populate
#. odoo-python
#: code:addons/populate/models/blueprint.py:0
msgid "Function blocks require 'name'."
msgstr "ບລັອກ Function ຕ້ອງການ 'name'."

#. module: populate
#. odoo-python
#: code:addons/populate/models/blueprint.py:0
msgid "Function blocks use 'arg', not 'field'."
msgstr "ບລັອກ Function ໃຊ້ 'arg', ບໍ່ແມ່ນ 'field'."

#. module: populate
#. odoo-python
#: code:addons/populate/models/blueprint.py:0
msgid "Function blocks use 'ref', not 'id'."
msgstr "ບລັອກ Function ໃຊ້ 'ref', ບໍ່ແມ່ນ 'id'."

#. module: populate
#: model:ir.module.module,summary:base.module_populate
msgid "Generate synthetic data for an Odoo database"
msgstr "ສ້າງຂໍ້ມູນຈຳລອງສຳລັບຖານຂໍ້ມູນ Odoo"

#. module: populate
