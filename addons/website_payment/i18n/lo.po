#. module: website_payment
#: model:ir.module.module,description:base.module_website_payment
msgid ""
"\n"
"This is a bridge module that adds multi-website support for payment "
"providers.\n"
msgstr ""
"\n"
"ນີ້ແມ່ນໂມດູນເຊື່ອມຕໍ່ທີ່ເພີ່ມການຮອງຮັບຫຼາຍເວັບໄຊສຳລັບຜູ້ໃຫ້ບໍລິການຊຳລະເງິນ.\n"

#. module: website_payment
#: model_terms:ir.ui.view,arch_db:website_payment.res_config_settings_view_form
msgid ""
"<span class=\"oe_inline pe-0\">\n"
"                            Install a payment provider to accept online "
"payments.\n"
"                        </span>"
msgstr ""
"<span class=\"oe_inline pe-0\">\n"
"                            ຕິດຕັ້ງຜູ້ໃຫ້ບໍລິການຊຳລະເງິນເພື່ອຮັບການຊຳລະເງິນອອນລາຍ.\n"
"                        </span>"

