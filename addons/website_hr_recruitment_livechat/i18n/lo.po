#. module: website_hr_recruitment_livechat
#: model_terms:chatbot.script.step,message:website_hr_recruitment_livechat.chatbot_script_website_hr_recruitment_rd_thanks
#: model_terms:chatbot.script.step,message:website_hr_recruitment_livechat.chatbot_script_website_hr_recruitment_sales_thanks
#: model_terms:chatbot.script.step,message:website_hr_recruitment_livechat.chatbot_script_website_hr_recruitment_services_community_thanks
#: model_terms:chatbot.script.step,message:website_hr_recruitment_livechat.chatbot_script_website_hr_recruitment_services_consultant_thanks
msgid "Thank you, you should hear back from us very soon!"
msgstr "ຂອບໃຈ, ພວກເຮົາຈະຕິດຕໍ່ກັບຫາເຈົ້າໃນໄວໆນີ້!"

#. module: website_hr_recruitment_livechat
#: model_terms:chatbot.script.step,message:website_hr_recruitment_livechat.chatbot_script_website_hr_recruitment_rd_chat_end
