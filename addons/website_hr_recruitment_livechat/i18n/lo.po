#: model_terms:chatbot.script.step,message:website_hr_recruitment_livechat.chatbot_script_website_hr_recruitment_service_consultant_chat_end
msgid "There you go, have a look."
msgstr "ນີ້ເລີຍ, ເຊີນກວດເບິ່ງໄດ້."

#. module: website_hr_recruitment_livechat
#: model_terms:chatbot.script.step,message:website_hr_recruitment_livechat.chatbot_script_website_hr_recruitment_sales_community_position
#: model_terms:chatbot.script.step,message:website_hr_recruitment_livechat.chatbot_script_website_hr_recruitment_services_community_position
msgid ""
"We have a community manager position in stock, it should fit your needs!"
msgstr ""
"ພວກເຮົາມີຕຳແໜ່ງຜູ້ຈັດການຊຸມຊົນທີ່ກຳລັງເປີດຮັບຢູ່, ໜ້າຈະເໝາະສົມກັບຄວາມຕ້ອງການຂອງເຈົ້າ!"

#. module: website_hr_recruitment_livechat
#: model_terms:chatbot.script.step,message:website_hr_recruitment_livechat.chatbot_script_website_hr_recruitment_services_consultant_position
msgid "We have a consultant position in stock, it should fit your needs!"
msgstr ""
"ພວກເຮົາມີຕຳແໜ່ງທີ່ປຶກສາທີ່ກຳລັງເປີດຮັບຢູ່, ໜ້າຈະເໝາະສົມກັບຄວາມຕ້ອງການຂອງເຈົ້າ!"

#. module: website_hr_recruitment_livechat
#: model_terms:chatbot.script.step,message:website_hr_recruitment_livechat.chatbot_script_website_hr_recruitment_rd_dev_position
msgid ""
"We have an experienced developer position in stock, it should fit your needs!"
msgstr ""
"ພວກເຮົາມີຕຳແໜ່ງນັກພັດທະນາທີ່ມີປະສົບການທີ່ກຳລັງເປີດຮັບຢູ່, ໜ້າຈະເໝາະສົມກັບຄວາມຕ້ອງການຂອງເຈົ້າ!"

