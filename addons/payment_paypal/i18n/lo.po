msgid ""
"<i class=\"oi me-2\" data-icon=\"block\" title=\"Restricted\"/>\n"
"                    <strong>Attention:</strong> Please confirm your email "
"address on PayPal to\n"
"                    receive payments."
msgstr ""
"<i class=\"oi me-2\" data-icon=\"block\" title=\"ຖືກຈຳກັດ\"/>\n"
"                    <strong>ຂໍ້ຄວນລະວັງ:</strong> ກະລຸນາຢືນຢັນທີ່ຢູ່ອີເມວຂອງທ່ານໃນ "
"PayPal ເພື່ອ\n"
"                    ຮັບການຊຳລະເງິນ."

#. module: payment_paypal
#: model_terms:ir.ui.view,arch_db:payment_paypal.payment_provider_form
msgid ""
"<i class=\"oi me-2\" data-icon=\"block\" title=\"Restricted\"/>\n"
"                    <strong>Attention:</strong> You currently cannot receive "
"payments due to a\n"
"                    possible restriction on your PayPal account. Please "
"reach out to PayPal Customer\n"
"                    Support."
msgstr ""
"<i class=\"oi me-2\" data-icon=\"block\" title=\"ຖືກຈຳກັດ\"/>\n"
"                    <strong>ຂໍ້ຄວນລະວັງ:</strong> ໃນຕອນນີ້ທ່ານບໍ່ສາມາດຮັບການຊຳລະເງິນໄດ້ "
"ເນື່ອງຈາກ\n"
"                    ອາດມີການຈຳກັດໃນບັນຊີ PayPal ຂອງທ່ານ. ກະລຸນາຕິດຕໍ່ຫາພາກສ່ວນຊ່ວຍເຫຼືອ\n"
"                    ລູກຄ້າຂອງ PayPal."

