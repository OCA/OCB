#. module: pos_bancontact_pay
#. odoo-python
#: code:addons/pos_bancontact_pay/models/res_company.py:0
msgid ""
"A Bancontact Pay payment method is linked to a journal that uses the "
"company's default currency.\n"
"This currency is not supported.\n"
"Supported currencies: %(currencies)s."
msgstr ""
"ວິທີການຊຳລະເງິນ Bancontact Pay ຖືກເຊື່ອມໂຍງກັບບັນຊີປະຈຳວັນທີ່ນຳໃຊ້ສະກຸນເງິນເລີ່ມຕົ້ນຂອງບໍລິສັດ.\n"
"ສະກຸນເງິນນີ້ບໍ່ຮອງຮັບ.\n"
"ສະກຸນເງິນທີ່ຮອງຮັບ: %(currencies)s."

#. module: pos_bancontact_pay
#. odoo-javascript
#: code:addons/pos_bancontact_pay/static/src/app/pos_store.js:0
msgid "A payment for order %s has expired."
msgstr "ການຊຳລະເງິນສຳລັບລາຍການສັ່ງຊື້ %s ໝົດອາຍຸແລ້ວ."

#. module: pos_bancontact_pay
#. odoo-javascript
#: code:addons/pos_bancontact_pay/static/src/app/pos_store.js:0
msgid "A payment for order %s has failed."
msgstr "ການຊຳລະເງິນສຳລັບລາຍການສັ່ງຊື້ %s ບໍ່ສຳເລັດ."

#. module: pos_bancontact_pay
#. odoo-javascript
#: code:addons/pos_bancontact_pay/static/src/app/pos_store.js:0
msgid "A payment for order %s was cancelled."
msgstr "ການຊຳລະເງິນສຳລັບລາຍການສັ່ງຊື້ %s ຖືກຍົກເລີກແລ້ວ."

#. module: pos_bancontact_pay
#: model:ir.module.module,summary:base.module_pos_bancontact_pay
msgid "Accept Bancontact Pay and Wero QR code payments in POS (Payconiq)."
msgstr ""
"ຮອງຮັບການຊຳລະເງິນຜ່ານ Bancontact Pay ແລະ Wero QR code ໃນ POS (Payconiq)."

#. module: pos_bancontact_pay
#. odoo-python
#: code:addons/pos_bancontact_pay/errors/http.py:0
msgid "Access denied. Please check your Bancontact permissions."
msgstr "ຖືກປະຕິເສດການເຂົ້າເຖິງ. ກະລຸນາກວດສອບສິດການນຳໃຊ້ Bancontact ຂອງທ່ານ."

#. module: pos_bancontact_pay
#. odoo-python
#: code:addons/pos_bancontact_pay/errors/http.py:0
msgid "Authentication with Bancontact failed. Please verify your API key."
msgstr ""
"ການຢືນຢັນຕົວຕົນກັບ Bancontact ບໍ່ສຳເລັດ. ກະລຸນາກວດສອບລະຫັດ API key ຂອງທ່ານ."

#. module: pos_bancontact_pay
