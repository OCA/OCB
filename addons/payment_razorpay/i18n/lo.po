#. module: payment_razorpay
#. odoo-python
#: code:addons/payment_razorpay/models/payment_provider.py:0
msgid ""
"Razorpay credentials are missing. Please fill them to set up your account."
msgstr ""
"ຂໍ້ມູນການຢືນຢັນຕົວຕົນຂອງ Razorpay ບໍ່ຄົບຖ້ວນ. ກະລຸນາປ້ອນຂໍ້ມູນໃສ່ເພື່ອຕັ້ງຄ່າບັນຊີຂອງທ່ານ."

#. module: payment_razorpay
#. odoo-python
#: code:addons/payment_razorpay/models/payment_provider.py:0
msgid ""
"Razorpay credentials are missing. Please set the state back to 'Disabled' "
"and click the \"Connect\" button to set up your account."
msgstr ""
"ຂໍ້ມູນການຢືນຢັນຕົວຕົນຂອງ Razorpay ບໍ່ຄົບຖ້ວນ. ກະລຸນາປ່ຽນສະຖານະກັບຄືນເປັນ 'ປິດການນຳໃຊ້' ແລ້ວກົດປຸ່ມ "
"\"ເຊື່ອມຕໍ່\" ເພື່ອຕັ້ງຄ່າບັນຊີຂອງທ່ານ."

#. module: payment_razorpay
#. odoo-python
#: code:addons/payment_razorpay/models/payment_provider.py:0
msgid ""
"Razorpay is not available in your country; please use another payment "
"provider."
msgstr ""
"Razorpay ບໍ່ມີໃຫ້ບໍລິການໃນປະເທດຂອງທ່ານ; ກະລຸນານຳໃຊ້ຜູ້ໃຫ້ບໍລິການຊຳລະເງິນອື່ນ."

#. module: payment_razorpay
#. odoo-python
#: code:addons/payment_razorpay/models/payment_transaction.py:0
msgid "Received data with invalid status: %s"
msgstr "ໄດ້ຮັບຂໍ້ມູນທີ່ມີສະຖານະບໍ່ຖືກຕ້ອງ: %s"

#. module: payment_razorpay
#. odoo-python
#: code:addons/payment_razorpay/models/payment_transaction.py:0
msgid "Received data with missing entity id."
msgstr "ໄດ້ຮັບຂໍ້ມູນທີ່ບໍ່ມີ Entity ID."

#. module: payment_razorpay
#. odoo-python
#: code:addons/payment_razorpay/models/payment_transaction.py:0
msgid "Received data with missing status."
msgstr "ໄດ້ຮັບຂໍ້ມູນທີ່ບໍ່ມີສະຖານະ."

#. module: payment_razorpay
#. odoo-python
#: code:addons/payment_razorpay/models/payment_transaction.py:0
msgid "Received incomplete refund data."
msgstr "ໄດ້ຮັບຂໍ້ມູນການສົ່ງເງິນຄືນບໍ່ຄົບຖ້ວນ."

